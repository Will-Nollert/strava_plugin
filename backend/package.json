{
  "name": "strava-plugin-oauth-proxy",
  "version": "1.0.0",
  "description": "Secure OAuth proxy and caching service for Strava Plugin Chrome extension",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "jest",
    "deploy": "sam deploy --guided",
    "clean": "rm -rf node_modules",
    "predeploy": "npm ci --production",
    "local": "sam local start-api",
    "validate-template": "sam validate"
  },
  "dependencies": {
    "aws-sdk": "^2.1048.0",
    "axios": "^1.8.3"
  },
  "devDependencies": {
    "jest": "^29.3.1",
    "aws-sdk-mock": "^5.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}