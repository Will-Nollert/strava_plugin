{
  "name": "strava-plugin-oauth-proxy",
  "version": "1.0.0",
  "description": "Secure OAuth proxy and caching service for Strava Plugin Chrome extension",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "jest",
    "lint": "eslint src --fix",
    "convert-icons": "node scripts/convert-icons.js",
    "prebuild": "npm run convert-icons",
    "prebuild:dev": "npm run convert-icons",
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "package": "node scripts/package.js",
    "watch": "webpack --mode development --watch",
    "prepush": "npm run lint && npm run test"
  },
  "dependencies": {
    "aws-sdk": "^2.1048.0",
    "axios": "^1.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "aws-sdk-mock": "^5.7.0",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.3.1",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
